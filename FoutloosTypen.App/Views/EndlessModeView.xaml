<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FoutloosTypen.Views.EndlessModeView"
    Title="Endless mode"
    BackgroundColor="White">

    <Grid RowDefinitions="Auto,*,Auto" Padding="12">

        <!-- ===== Top bar ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image
                Source="boltype.png"
                HeightRequest="140"
                WidthRequest="140"
                Margin="0,0,0,10"
                VerticalOptions="End"/>

            <HorizontalStackLayout
                Grid.Column="1"
                Spacing="12"
                VerticalOptions="Center"
                Margin="0,0,16,0">

                <ImageButton
                    Source="person.png"
                    Command="{Binding ProfileCommand}"
                    BackgroundColor="Transparent"
                    WidthRequest="48"
                    HeightRequest="48"/>

                <ImageButton
                    Source="home.png"
                    Clicked="OnHomeClicked"
                    BackgroundColor="Transparent"
                    WidthRequest="48"
                    HeightRequest="48"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- ===== Game area ===== -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="16"
            HorizontalOptions="Fill"
            VerticalOptions="Center">

            <!-- Timer -->
            <Label
                Text="{Binding Timer.TimeRemainingFormatted}"
                TextColor="{Binding TimerColor}"
                FontSize="28"
                HorizontalOptions="Center"/>

            <Label x:Name="ScoreLabel"
       Text="{Binding Score}"
       FontSize="28"
       FontAttributes="Bold"
       TextColor="Black"
       HorizontalOptions="Center"/>


            <!-- Combo -->
            <Label
                x:Name="ComboLabel"
                Text="{Binding ComboText}"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="Orange"
                HorizontalOptions="Center"/>

            <!-- Word -->
            <Frame
                Padding="24"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="Transparent">

                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">

                    <Label
                        FormattedText="{Binding FormattedText}"
                        FontSize="32"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="NoWrap"/>

                    <!-- Hidden input -->
                    <Entry
                        x:Name="HiddenEntry"
                        Text="{Binding UserInput, Mode=TwoWay}"
                        TextChanged="OnTextChanged"
                        Opacity="0"
                        HeightRequest="0"/>

                    <BoxView
                        HeightRequest="80"
                        WidthRequest="400"
                        Color="Transparent">
                        <BoxView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTapToFocus"/>
                        </BoxView.GestureRecognizers>
                    </BoxView>

                </VerticalStackLayout>
            </Frame>

            <!-- Restart -->
            <Button
                Text="↻"
                Command="{Binding RefreshCommand}"
                FontSize="50"
                BackgroundColor="Transparent"
                HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <Grid Grid.Row="2"/>
    </Grid>
</ContentPage>
