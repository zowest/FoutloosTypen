<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FoutloosTypen.Views.EndlessModeView"
    BackgroundColor="White">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16">

        <!-- ================= TOP BAR ================= -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <Image
                Source="boltype.png"
                HeightRequest="96"
                HorizontalOptions="Start"
                VerticalOptions="Center" />

            <ImageButton
                Grid.Column="1"
                Source="home.png"
                BackgroundColor="Transparent"
                WidthRequest="40"
                HeightRequest="40"
                Clicked="OnHomeClicked" />
        </Grid>

        <!-- ================= GAME CONTENT ================= -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="20"
            HorizontalOptions="Fill"
            VerticalOptions="Center">

            <Label
                Text="{Binding Timer.TimeRemainingFormatted}"
                TextColor="{Binding TimerColor}"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="16">

                <Label
                    Text="{Binding Score}"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="Black" />
            </HorizontalStackLayout>

            <VerticalStackLayout
                HorizontalOptions="Center"
                Spacing="12">

                <Label
                    FormattedText="{Binding FormattedText}"
                    FontSize="32"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="NoWrap" />

                <Entry
                    x:Name="HiddenEntry"
                    Text="{Binding UserInput}"
                    TextChanged="OnTextChanged"
                    Opacity="0"
                    HeightRequest="1"
                    HorizontalOptions="Fill" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- ================= COMBO TEXT + BAR ================= -->
        <VerticalStackLayout
            Grid.Row="2"
            Spacing="6"
            HorizontalOptions="Center">

            <Label
                Text="{Binding ComboText}"
                FontSize="16"
                TextColor="OrangeRed"
                HorizontalOptions="Center" />

            <GraphicsView
                x:Name="ComboBar"
                HeightRequest="8"
                WidthRequest="240"
                HorizontalOptions="Center" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
