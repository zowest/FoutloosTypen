<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="FoutloosTypen.Views.ImagePreviewPopup"
    Size="800,1000">

	<Frame
		Padding="12"
		BackgroundColor="White"
		CornerRadius="12"
		HasShadow="True"
		WidthRequest="800"
		HeightRequest="1000">

		<Grid RowDefinitions="Auto,*,Auto,Auto" ColumnDefinitions="*">
			<Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
				<Label Text="Preview" VerticalOptions="Center" FontAttributes="Bold" FontSize="20" />
				<Button x:Name="CancelButton" 
                        Text="Cancel" 
                        Grid.Column="1" 
                        Margin="8,0" />
				<Button x:Name="ShareButton" 
                        Text="Share" 
                        Grid.Column="2" 
                        Margin="8,0"
                        BackgroundColor="#1DA1F2"
                        TextColor="White" />
			</Grid>

            <ScrollView Grid.Row="1">
			    <VerticalStackLayout Spacing="8">
                    <Image
                        x:Name="PreviewImage"
                        HorizontalOptions="Fill"
                        VerticalOptions="Center"
                        Aspect="AspectFit"
                        HeightRequest="600" />
                    <Label
                        x:Name="TweetLabel"
                        LineBreakMode="WordWrap"
                        VerticalOptions="Center"
                        FontSize="16"
                        Margin="0,8,0,0" />
                </VerticalStackLayout>
            </ScrollView>

            <!-- Status message area -->
            <VerticalStackLayout Grid.Row="2" 
                                 Spacing="8" 
                                 Margin="0,8,0,8"
                                 IsVisible="{Binding IsSharing}">
                <ActivityIndicator IsRunning="{Binding IsSharing}" 
                                   Color="#1DA1F2"
                                   HeightRequest="32"
                                   WidthRequest="32"
                                   HorizontalOptions="Center" />
                <Label Text="{Binding StatusMessage}"
                       HorizontalOptions="Center"
                       FontSize="14"
                       TextColor="Gray" />
            </VerticalStackLayout>

		</Grid>
	</Frame>
</toolkit:Popup>