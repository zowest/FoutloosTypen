<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="FoutloosTypen.Views.ImagePreviewPopup"
    Size="600,800">

	<Frame
		Padding="12"
		BackgroundColor="White"
		CornerRadius="12"
		HasShadow="True"
		WidthRequest="600"
		HeightRequest="800">

		<Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*">
			<Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
				<Label Text="Preview" VerticalOptions="Center" FontAttributes="Bold" />
				<Button x:Name="CancelButton" Text="Cancel" Grid.Column="1" Margin="8,0" />
				<Button x:Name="ShareButton" Text="Share" Grid.Column="2" Margin="8,0" />
			</Grid>

			<Image
				x:Name="PreviewImage"
				Grid.Row="1"
				HorizontalOptions="Fill"
				VerticalOptions="Fill"
				Aspect="AspectFit" />

			<Label
				x:Name="TweetLabel"
				Grid.Row="2"
				LineBreakMode="TailTruncation"
				VerticalOptions="Center"
				Margin="0,8,0,0" />
		</Grid>
	</Frame>
</toolkit:Popup>