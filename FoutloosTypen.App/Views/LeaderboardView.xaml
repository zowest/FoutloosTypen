<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoutloosTypen.Views.LeaderboardView"
             Title="Klassement"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">
    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Lesson-specific leaderboard -->
        <Border Grid.Row="0"
                Stroke="Black"
                StrokeThickness="2"
                Padding="20"
                BackgroundColor="White"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                WidthRequest="700"
                Margin="0,20"
                IsVisible="{Binding IsLessonSpecific}">
            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                    <Label Text="🏵️" FontSize="26" />
                    <Label Text="{Binding PageTitle}" FontSize="28" FontAttributes="Bold" />
                    <Label Text="🏵️" FontSize="26" />
                </HorizontalStackLayout>

                <BoxView HeightRequest="2" Color="Black" WidthRequest="200" />

                <CollectionView ItemsSource="{Binding LessonResults}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <Label Grid.Column="0"
                                       Text="{Binding Rank, StringFormat='#{0}'}"
                                       FontSize="18"
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="1"
                                       Text="{Binding StudentName}"
                                       FontSize="18"
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="2"
                                       Text="{Binding Score}"
                                       FontSize="18"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="End"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <!-- Current student's rank small footer -->
        <Border Grid.Row="1"
                Stroke="#FF6200EE"
                StrokeThickness="2"
                BackgroundColor="#F8F8FF"
                Padding="15"
                Margin="0,20,0,0"
                IsVisible="{Binding CurrentStudentRank}">
            <HorizontalStackLayout Spacing="10">
                <Label Text="Jouw positie:" TextColor="Black" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"/>
                <Label Text="{Binding CurrentStudentRank, StringFormat='#{0}'}" TextColor="#FF6200EE" FontSize="24" FontAttributes="Bold" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentPage>