<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoutloosTypen.Views.LeaderboardView"
             Title="Klassement"
             BackgroundColor="White"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">
    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Home Button -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" 
                   Text="{Binding PageTitle}" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   TextColor="Black"
                   VerticalOptions="Center"/>

            <ImageButton Grid.Column="1"
                         Source="home.png"
                         HeightRequest="40"
                         WidthRequest="40"
                         Command="{Binding NavigateHomeCommand}"
                         VerticalOptions="Center"/>
        </Grid>

        <!-- Tab Buttons (no converter) -->
        <HorizontalStackLayout Grid.Row="1" 
                               Spacing="10" 
                               HorizontalOptions="Center"
                               Margin="0,0,0,20">
            <Button Text="Totale Score"
                    Command="{Binding SelectTotalScoreTabCommand}"
                    TextColor="White"
                    Padding="20,10"
                    CornerRadius="8"
                    FontAttributes="Bold">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BackgroundColor" Value="#CCCCCC"/>
                        <Style.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsTotalScoreTabSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="#FF6200EE"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Text="Endless"
                    Command="{Binding SelectEndlessTabCommand}"
                    TextColor="White"
                    Padding="20,10"
                    CornerRadius="8"
                    FontAttributes="Bold">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BackgroundColor" Value="#CCCCCC"/>
                        <Style.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsEndlessTabSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="#FF6200EE"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </HorizontalStackLayout>

        <!-- Content Area -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="20">

                <!-- Total Score Tab Content -->
                <VerticalStackLayout IsVisible="{Binding IsTotalScoreTabSelected}" Spacing="15">
                    <!-- Leaderboard Header -->
                    <Grid Padding="10" BackgroundColor="#F0F0F0" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Text="Rang" FontAttributes="Bold" TextColor="Black"/>
                        <Label Grid.Column="1" Text="Naam" FontAttributes="Bold" TextColor="Black"/>
                        <Label Grid.Column="2" Text="Score" FontAttributes="Bold" TextColor="Black" HorizontalOptions="End"/>
                    </Grid>

                    <!-- Student List (uses LeaderboardStudent from VM) -->
                    <CollectionView ItemsSource="{Binding TopStudents}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.Triggers>
                                        <DataTrigger TargetType="Grid" Binding="{Binding IsCurrentUser}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#E3F2FD"/>
                                        </DataTrigger>
                                    </Grid.Triggers>

                                    <Label Grid.Column="0" 
                                           Text="{Binding Rank, StringFormat='#{0}'}" 
                                           TextColor="Black" 
                                           FontSize="18" 
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="1" 
                                           Text="{Binding Name}" 
                                           TextColor="Black" 
                                           FontSize="18" 
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="2" 
                                           Text="{Binding TotalScore}" 
                                           TextColor="Black" 
                                           FontSize="18" 
                                           FontAttributes="Bold" 
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Endless Mode Tab Content -->
                <VerticalStackLayout IsVisible="{Binding IsEndlessTabSelected}" Spacing="15">
                    <!-- Leaderboard Header -->
                    <Grid Padding="10" BackgroundColor="#F0F0F0" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Text="Rang" FontAttributes="Bold" TextColor="Black"/>
                        <Label Grid.Column="1" Text="Naam" FontAttributes="Bold" TextColor="Black"/>
                        <Label Grid.Column="2" Text="Beste Score" FontAttributes="Bold" TextColor="Black" HorizontalOptions="End"/>
                    </Grid>

                    <!-- Endless Mode Results -->
                    <CollectionView ItemsSource="{Binding EndlessResults}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.Triggers>
                                        <DataTrigger TargetType="Grid" Binding="{Binding IsCurrentUser}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#FFF8E1"/>
                                        </DataTrigger>
                                    </Grid.Triggers>

                                    <Label Grid.Column="0" 
                                           Text="{Binding Rank, StringFormat='#{0}'}" 
                                           TextColor="Black" 
                                           FontSize="18" 
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="1" 
                                           Text="{Binding Name}" 
                                           TextColor="Black" 
                                           FontSize="18" 
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="2" 
                                           Text="{Binding TotalScore}" 
                                           TextColor="Black" 
                                           FontSize="18" 
                                           FontAttributes="Bold" 
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Spacing="20"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="Center"
                                                 Padding="40">
                                <Label Text="🎮" 
                                       FontSize="64" 
                                       HorizontalOptions="Center"/>
                                <Label Text="Nog geen Endless Mode scores" 
                                       FontSize="24" 
                                       FontAttributes="Bold" 
                                       HorizontalOptions="Center"
                                       TextColor="Black"/>
                                <Label Text="Speel je eerste Endless Mode game om op het klassement te komen!" 
                                       FontSize="18" 
                                       HorizontalOptions="Center"
                                       TextColor="#666666"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,10"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Current Student Rank Footer -->
        <Border Grid.Row="3"
                Stroke="#FF6200EE"
                StrokeThickness="2"
                BackgroundColor="#F8F8FF"
                Padding="15"
                Margin="0,20,0,0"
                IsVisible="{Binding CurrentStudentRank}">
            <HorizontalStackLayout Spacing="10">
                <Label Text="Jouw positie:" 
                       TextColor="Black" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       VerticalOptions="Center"/>
                <Label Text="{Binding CurrentStudentRank, StringFormat='#{0}'}" 
                       TextColor="#FF6200EE" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentPage>