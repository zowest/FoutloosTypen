<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoutloosTypen.Views.LessonCompletedPopup"
             BackgroundColor="#80000000">
    <Frame BackgroundColor="White"
           BorderColor="Black"
           CornerRadius="20"
           Padding="40"
           WidthRequest="600"
           HeightRequest="400"
           HorizontalOptions="Center"
           VerticalOptions="Center"
           HasShadow="True">
        <VerticalStackLayout Spacing="30" 
                             HorizontalOptions="Center" 
                             VerticalOptions="Center">

            <Label Text="??"
                   FontSize="80"
                   HorizontalOptions="Center"/>

            <Label Text="Les Voltooid!"
                   FontSize="48"
                   FontAttributes="Bold"
                   TextColor="Black"
                   HorizontalOptions="Center"/>

            <Button Text="Ga verder"
                    FontSize="24"
                    BackgroundColor="White"
                    TextColor="Black"
                    BorderColor="Black"
                    BorderWidth="2"
                    WidthRequest="250"
                    HeightRequest="70"
                    HorizontalOptions="Center"
                    Clicked="OnContinueClicked">
                <Button.GestureRecognizers>
                    <PointerGestureRecognizer
                        PointerEntered="OnHoverEnter"
                        PointerExited="OnHoverExit"/>
                </Button.GestureRecognizers>
            </Button>
        </VerticalStackLayout>
    </Frame>
</ContentPage>