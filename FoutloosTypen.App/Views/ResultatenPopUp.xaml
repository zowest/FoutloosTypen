<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoutloosTypen.Views.ResultatenPopUp"
             BackgroundColor="#80000000">
    <Frame BackgroundColor="White"
           BorderColor="Black"
           CornerRadius="20"
           Padding="30"
           MaximumWidthRequest="1000"
           MaximumHeightRequest="600"
           HorizontalOptions="Center"
           VerticalOptions="Center">
        <Grid>
            <ImageButton Source="x.png"
                         BackgroundColor="Transparent"
                         Command="{Binding ShareToTwitterCommand}"
                         IsEnabled="{Binding CanShare}"
                         ToolTipProperties.Text="Deel op X (Twitter)"
                         WidthRequest="48"
                         HeightRequest="48"
                         HorizontalOptions="End"
                         VerticalOptions="Start"
                         Padding="0"
                         Opacity="1.0">
                <ImageButton.GestureRecognizers>
                    <PointerGestureRecognizer
                        PointerEntered="OnHoverEnter"
                        PointerExited="OnHoverExit"/>
                </ImageButton.GestureRecognizers>
            </ImageButton>

            <VerticalStackLayout Spacing="80" 
                                 HorizontalOptions="Center" 
                                 VerticalOptions="Center">

                <Label Text="{Binding ResultTitle}"
                       FontSize="48"
                       FontAttributes="Bold"
                       TextColor="Black"
                       HorizontalOptions="Center"/>
                <VerticalStackLayout
                    HorizontalOptions="Start">
                    <Label Text="Resultaten: "
                           TextColor="Black"
                           FontSize="24"
                           FontAttributes="Bold"/>
                    <HorizontalStackLayout>
                        <Label Text="Score: "
                            TextColor="Black"/>
                        <Label Text="{Binding Score}"
                               TextColor="Black"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout>
                        <Label Text="APM:"
                           TextColor="Black"/>
                        <Label Text="{Binding StrokesPerMinute}"
                            TextColor="Black"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout>
                        <Label Text="WPM:"
                           TextColor="Black"/>
                        <Label Text="{Binding WordsPerMinute}"
                            TextColor="Black"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout>
                        <Label Text="Nauwkeurigheid:"
                           TextColor="Black"/>
                        <Label Text="{Binding Accuracy}"
                             TextColor="Black"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout>
                        <Label Text="Fouten:"
                            TextColor="Black"/>
                        <Label Text="{Binding TotalMistakes}"
                             TextColor="Black"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout>
                        <Label Text="Tijd over: "
                           TextColor="Black"/>
                        <Label Text="{Binding TimeRemaining}"
                            TextColor="Black"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
                <HorizontalStackLayout
                    Spacing="300"
                    VerticalOptions="End"
                    HorizontalOptions="Center">
                    
                    <ImageButton Source="herstart.png"
                 BackgroundColor="Transparent"
                 BorderColor="Transparent"
                 BorderWidth="0"
                 CornerRadius="0"
                 Padding="0"
                 WidthRequest="48"
                 HeightRequest="48"
                 Aspect="AspectFit"
                 Clicked="OnRestartClicked">
                        <ImageButton.GestureRecognizers>
                            <PointerGestureRecognizer
                PointerEntered="OnHoverEnter"
                PointerExited="OnHoverExit"/>
                        </ImageButton.GestureRecognizers>
                    </ImageButton>
                    <ImageButton Source="home.png"
                             Clicked="OnContinueClicked"
                             BackgroundColor="Transparent"
                             BorderColor="Transparent"
                             BorderWidth="0"
                             CornerRadius="0"
                             Padding="0"
                             WidthRequest="48"
                             HeightRequest="48"
                             Aspect="AspectFit" >
                        <ImageButton.GestureRecognizers>
                            <PointerGestureRecognizer
                PointerEntered="OnHoverEnter"
                PointerExited="OnHoverExit"/>
                        </ImageButton.GestureRecognizers>
                    </ImageButton>
                    <ImageButton Source="arrowright.png"
                             Clicked="OnNextLessonClicked"
                             BackgroundColor="Transparent"
                             BorderColor="Transparent"
                             BorderWidth="0"
                             CornerRadius="0"
                             Padding="0"
                             WidthRequest="48"
                             HeightRequest="48"
                             Aspect="AspectFit" >
        <ScrollView>
            <VerticalStackLayout Spacing="15">

                <!-- Title -->
                <Label Text="{Binding ResultTitle}"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="Black"
                       HorizontalOptions="Center"/>

                <!-- Single Badge (First Attempt OR New Record) -->
                <Border IsVisible="{Binding ShowFirstAttemptBadge}"
                        BackgroundColor="#2196F3"
                        Stroke="#1565C0"
                        StrokeThickness="2"
                        Padding="12,6"
                        HorizontalOptions="Center">
                    <Label Text="🎯 Eerste poging!"
                           TextColor="White"
                           FontSize="18"
                           FontAttributes="Bold"/>
                </Border>

                <Border IsVisible="{Binding ShowComparisonBadge}"
                        BackgroundColor="#4CAF50"
                        Stroke="#2E7D32"
                        StrokeThickness="2"
                        Padding="12,6"
                        HorizontalOptions="Center">
                    <Label Text="🎉 Nieuw persoonlijk record!"
                           TextColor="White"
                           FontSize="18"
                           FontAttributes="Bold"/>
                </Border>

                <!-- Results Comparison - FIXED: Wider columns to prevent text clipping -->
                <Grid ColumnSpacing="20" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Current Results -->
                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                        <Label Text="Huidige Poging"
                               TextColor="Black"
                               FontSize="18"
                               FontAttributes="Bold"
                               Margin="0,0,0,8"/>
                        
                        <HorizontalStackLayout>
                            <Label Text="Score:" TextColor="Black" FontSize="14" WidthRequest="140"/>
                            <Label Text="{Binding Score}" TextColor="Black" FontSize="14" FontAttributes="Bold"/>
                        </HorizontalStackLayout>
                        
                        <HorizontalStackLayout>
                            <Label Text="WPM:" TextColor="Black" FontSize="14" WidthRequest="140"/>
                            <Label Text="{Binding WordsPerMinute}" TextColor="Black" FontSize="14" FontAttributes="Bold"/>
                        </HorizontalStackLayout>
                        
                        <HorizontalStackLayout>
                            <Label Text="Nauwkeurigheid:" TextColor="Black" FontSize="14" WidthRequest="140"/>
                            <Label Text="{Binding Accuracy}" TextColor="Black" FontSize="14" FontAttributes="Bold"/>
                        </HorizontalStackLayout>
                        
                        <HorizontalStackLayout>
                            <Label Text="APM:" TextColor="Black" FontSize="14" WidthRequest="140"/>
                            <Label Text="{Binding StrokesPerMinute}" TextColor="Black" FontSize="14"/>
                        </HorizontalStackLayout>
                        
                        <HorizontalStackLayout>
                            <Label Text="Fouten:" TextColor="Black" FontSize="14" WidthRequest="140"/>
                            <Label Text="{Binding TotalMistakes}" TextColor="Black" FontSize="14"/>
                        </HorizontalStackLayout>
                        
                        <HorizontalStackLayout>
                            <Label Text="Tijd over:" TextColor="Black" FontSize="14" WidthRequest="140"/>
                            <Label Text="{Binding TimeRemaining}" TextColor="Black" FontSize="14"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Divider -->
                    <BoxView Grid.Column="1"
                             WidthRequest="2"
                             BackgroundColor="LightGray"
                             IsVisible="{Binding HasPreviousAttempt}"/>

                    <!-- Previous Best -->
                    <VerticalStackLayout Grid.Column="2" 
                                         Spacing="3"
                                         IsVisible="{Binding HasPreviousAttempt}">
                        <Label Text="Vorige Beste"
                               TextColor="Gray"
                               FontSize="18"
                               FontAttributes="Bold"
                               Margin="0,0,0,8"/>
                        
                        <HorizontalStackLayout>
                            <Label Text="Score:" TextColor="Gray" FontSize="13" WidthRequest="140"/>
                            <Label Text="{Binding PreviousBestScore}" TextColor="Gray" FontSize="13"/>
                            <Label Text="{Binding ScoreDifferenceText}" 
                                   TextColor="{Binding ScoreDifferenceColor}" 
                                   FontSize="12" 
                                   FontAttributes="Italic" 
                                   Margin="5,0,0,0"/>
                        </HorizontalStackLayout>
                        
                        <HorizontalStackLayout>
                            <Label Text="WPM:" TextColor="Gray" FontSize="13" WidthRequest="140"/>
                            <Label Text="{Binding PreviousBestWPM}" TextColor="Gray" FontSize="13"/>
                            <Label Text="{Binding SpeedDifferenceText}" 
                                   TextColor="{Binding SpeedDifferenceColor}" 
                                   FontSize="12" 
                                   FontAttributes="Italic" 
                                   Margin="5,0,0,0"/>
                        </HorizontalStackLayout>
                        
                        <HorizontalStackLayout>
                            <Label Text="Nauwkeurigheid:" TextColor="Gray" FontSize="13" WidthRequest="140"/>
                            <Label Text="{Binding PreviousBestAccuracy}" TextColor="Gray" FontSize="13"/>
                            <Label Text="{Binding AccuracyDifferenceText}" 
                                   TextColor="{Binding AccuracyDifferenceColor}" 
                                   FontSize="12" 
                                   FontAttributes="Italic" 
                                   Margin="5,0,0,0"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <!-- Buttons -->
                <HorizontalStackLayout Spacing="60"
                                       HorizontalOptions="Center"
                                       Margin="0,20,0,0">
                    
                    <ImageButton Source="herstart.png"
                                 BackgroundColor="Transparent"
                                 WidthRequest="48"
                                 HeightRequest="48"
                                 Aspect="AspectFit"
                                 Clicked="OnRestartClicked">
                        <ImageButton.GestureRecognizers>
                            <PointerGestureRecognizer
                                PointerEntered="OnHoverEnter"
                                PointerExited="OnHoverExit"/>
                        </ImageButton.GestureRecognizers>
                    </ImageButton>
                    
                    <ImageButton Source="home.png"
                                 BackgroundColor="Transparent"
                                 WidthRequest="48"
                                 HeightRequest="48"
                                 Aspect="AspectFit"
                                 Clicked="OnContinueClicked">
                        <ImageButton.GestureRecognizers>
                            <PointerGestureRecognizer
                                PointerEntered="OnHoverEnter"
                                PointerExited="OnHoverExit"/>
                        </ImageButton.GestureRecognizers>
                    </ImageButton>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>
        </ScrollView>
    </Frame>
</ContentPage>