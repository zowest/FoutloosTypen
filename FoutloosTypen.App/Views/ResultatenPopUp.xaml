<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoutloosTypen.Views.ResultatenPopUp"
             BackgroundColor="#80000000">
    <Frame BackgroundColor="White"
           BorderColor="Black"
           CornerRadius="20"
           Padding="40"
           WidthRequest="1000"
           HeightRequest="500"
           HorizontalOptions="Center"
           VerticalOptions="Center">
        <VerticalStackLayout Spacing="80" 
                             HorizontalOptions="Center" 
                             VerticalOptions="Center">

            <Label Text="{Binding ResultTitle}"
                   FontSize="48"
                   FontAttributes="Bold"
                   TextColor="Black"
                   HorizontalOptions="Center"/>
            <VerticalStackLayout
                HorizontalOptions="Start">
                <Label Text="Resultaten: "
                       TextColor="Black"
                       FontSize="24"
                       FontAttributes="Bold"/>
                <HorizontalStackLayout>
                    <Label Text="Score: "
                        TextColor="Black"/>
                    <Label Text="{Binding Score}"
                           TextColor="Black"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="APM:"
                       TextColor="Black"/>
                    <Label Text="{Binding StrokesPerMinute}"
                        TextColor="Black"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="WPM:"
                       TextColor="Black"/>
                    <Label Text="{Binding WordsPerMinute}"
                        TextColor="Black"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Nauwkeurigheid:"
                       TextColor="Black"/>
                    <Label Text="{Binding Accuracy}"
                         TextColor="Black"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Fouten:"
                        TextColor="Black"/>
                    <Label Text="{Binding TotalMistakes}"
                         TextColor="Black"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Tijd over: "
                       TextColor="Black"/>
                    <Label Text="{Binding TimeRemaining}"
                        TextColor="Black"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <HorizontalStackLayout
                Spacing="300"
                VerticalOptions="End"
                HorizontalOptions="Center">
                <Button Text="Herstart"
                        FontSize="12"
                        BackgroundColor="White"
                        TextColor="Black"
                        BorderColor="Black"
                        BorderWidth="2"
                        WidthRequest="100"
                        HeightRequest="30"
                        HorizontalOptions="Start"
                        Clicked="OnRestartClicked">
                    <Button.GestureRecognizers>
                        <PointerGestureRecognizer
                            PointerEntered="OnHoverEnter"
                            PointerExited="OnHoverExit"/>
                    </Button.GestureRecognizers>
                </Button>
                <Button Text="Ga verder"
                        FontSize="12"
                        BackgroundColor="White"
                        TextColor="Black"
                        BorderColor="Black"
                        BorderWidth="2"
                        WidthRequest="100"
                        HeightRequest="30"
                        HorizontalOptions="Center"
                        Clicked="OnContinueClicked">
                    <Button.GestureRecognizers>
                        <PointerGestureRecognizer
                            PointerEntered="OnHoverEnter"
                            PointerExited="OnHoverExit"/>
                    </Button.GestureRecognizers>
                </Button>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Frame>
</ContentPage>