<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoutloosTypen.Views.ResultatenPopUp"
             BackgroundColor="#80000000">
    <Frame BackgroundColor="White"
           BorderColor="Black"
           CornerRadius="20"
           Padding="30"
           MaximumWidthRequest="1000"
           MaximumHeightRequest="600"
           HorizontalOptions="Center"
           VerticalOptions="Center">
        <Grid>
            <!-- Top right buttons -->
            <HorizontalStackLayout HorizontalOptions="End"
                                   VerticalOptions="Start"
                                   Spacing="10">
                <!-- Settings Button -->
                <ImageButton Source="settings.png"
                             BackgroundColor="Transparent"
                             ToolTipProperties.Text="Instellingen"
                             WidthRequest="48"
                             HeightRequest="48"
                             Padding="0"
                             Opacity="1.0"
                             Clicked="OnSettingsClicked">
                    <ImageButton.GestureRecognizers>
                        <PointerGestureRecognizer
                            PointerEntered="OnHoverEnter"
                            PointerExited="OnHoverExit"/>
                    </ImageButton.GestureRecognizers>
                </ImageButton>

                <!-- X Share Button -->
                <ImageButton Source="x.png"
                             BackgroundColor="Transparent"
                             Command="{Binding ShareToTwitterCommand}"
                             IsEnabled="{Binding CanShare}"
                             ToolTipProperties.Text="Deel op X (Twitter)"
                             WidthRequest="48"
                             HeightRequest="48"
                             Padding="0"
                             Opacity="1.0">
                    <ImageButton.GestureRecognizers>
                        <PointerGestureRecognizer
                            PointerEntered="OnHoverEnter"
                            PointerExited="OnHoverExit"/>
                    </ImageButton.GestureRecognizers>
                </ImageButton>
            </HorizontalStackLayout>

            <!-- Switch X Account info (below share button) -->
            <VerticalStackLayout HorizontalOptions="End"
                                 VerticalOptions="Start"
                                 Margin="0,60,0,0"
                                 Spacing="4"
                                 x:Name="XAccountSwitcher">
                <Label Text="{Binding CurrentXUsername}"
                       FontSize="12"
                       TextColor="Gray"
                       HorizontalOptions="End"/>
                <Button Text="Wissel X-account"
                        FontSize="10"
                        Padding="8,4"
                        BackgroundColor="LightGray"
                        TextColor="Black"
                        CornerRadius="4"
                        Command="{Binding SwitchXAccountCommand}"
                        IsEnabled="{Binding CanShare}">
                    <Button.GestureRecognizers>
                        <PointerGestureRecognizer
                            PointerEntered="OnHoverEnter"
                            PointerExited="OnHoverExit"/>
                    </Button.GestureRecognizers>
                </Button>
            </VerticalStackLayout>

            <ScrollView>
                <VerticalStackLayout Spacing="40" 
                                     HorizontalOptions="Center" 
                                     VerticalOptions="Center"
                                     Padding="20">
                    <Label Text="{Binding ResultTitle}"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="Black"
                           HorizontalOptions="Center"/>

                    <!-- Results -->
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                            <Label Text="Score:" TextColor="Black" FontSize="18" FontAttributes="Bold"/>
                            <Label Text="{Binding Score}" TextColor="Black" FontSize="18" FontAttributes="Bold"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                            <Label Text="WPM:" TextColor="Black" FontSize="16"/>
                            <Label Text="{Binding WordsPerMinute}" TextColor="Black" FontSize="16"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                            <Label Text="APM:" TextColor="Black" FontSize="16"/>
                            <Label Text="{Binding StrokesPerMinute}" TextColor="Black" FontSize="16"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                            <Label Text="Nauwkeurigheid:" TextColor="Black" FontSize="16"/>
                            <Label Text="{Binding Accuracy}" TextColor="Black" FontSize="16"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                            <Label Text="Fouten:" TextColor="Black" FontSize="16"/>
                            <Label Text="{Binding TotalMistakes}" TextColor="Black" FontSize="16"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Buttons -->
                    <HorizontalStackLayout Spacing="60"
                                           HorizontalOptions="Center"
                                           Margin="0,20,0,0">

                        <ImageButton Source="herstart.png"
                                     BackgroundColor="Transparent"
                                     WidthRequest="48"
                                     HeightRequest="48"
                                     Aspect="AspectFit"
                                     ToolTipProperties.Text="Herstart les"
                                     Clicked="OnRestartClicked">
                            <ImageButton.GestureRecognizers>
                                <PointerGestureRecognizer
                                    PointerEntered="OnHoverEnter"
                                    PointerExited="OnHoverExit"/>
                            </ImageButton.GestureRecognizers>
                        </ImageButton>

                        <ImageButton Source="home.png"
                                     BackgroundColor="Transparent"
                                     WidthRequest="48"
                                     HeightRequest="48"
                                     Aspect="AspectFit"
                                     ToolTipProperties.Text="Terug naar home"
                                     Clicked="OnContinueClicked">
                            <ImageButton.GestureRecognizers>
                                <PointerGestureRecognizer
                                    PointerEntered="OnHoverEnter"
                                    PointerExited="OnHoverExit"/>
                            </ImageButton.GestureRecognizers>
                        </ImageButton>

                        <ImageButton Source="next.png"
                                     BackgroundColor="Transparent"
                                     WidthRequest="48"
                                     HeightRequest="48"
                                     Aspect="AspectFit"
                                     ToolTipProperties.Text="Volgende les"
                                     Clicked="OnNextLessonClicked">
                            <ImageButton.GestureRecognizers>
                                <PointerGestureRecognizer
                                    PointerEntered="OnHoverEnter"
                                    PointerExited="OnHoverExit"/>
                            </ImageButton.GestureRecognizers>
                        </ImageButton>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Frame>
</ContentPage>